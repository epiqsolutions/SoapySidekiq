# Remove only this build's installed files. Empty directories are left intact.
if(NOT DEFINED MANIFEST OR NOT EXISTS "${MANIFEST}")
    message(FATAL_ERROR "Install manifest not found; install this build first")
endif()
file(STRINGS "${MANIFEST}" installed_files)
foreach(installed IN LISTS installed_files)
    if(NOT IS_ABSOLUTE "${installed}")
        message(FATAL_ERROR "Refusing a relative install manifest entry: ${installed}")
    endif()
    set(path "$ENV{DESTDIR}${installed}")
    if(IS_DIRECTORY "${path}" AND NOT IS_SYMLINK "${path}")
        message(FATAL_ERROR "Refusing to remove a directory: ${path}")
    endif()
    if(EXISTS "${path}" OR IS_SYMLINK "${path}")
        message(STATUS "Removing ${path}")
        file(REMOVE "${path}")
        if(EXISTS "${path}" OR IS_SYMLINK "${path}")
            message(FATAL_ERROR "Could not remove ${path}; check permissions")
        endif()
    endif()
endforeach()
